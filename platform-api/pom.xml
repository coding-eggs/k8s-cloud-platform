<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.coding</groupId>
        <artifactId>k8s-cloud-platform</artifactId>
        <version>1.0.0</version>
        <!-- 加上这一行，强制使用本地父 POM -->
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>platform-api</artifactId>
    <!-- 版本继承父 POM（1.0.0），与本仓其余模块一致；以前单独写 0.0.1-SNAPSHOT，
         产物名/镜像 tag 跟别人对不上，排查时容易误判。 -->
    <name>platform-api</name>
    <description>platform-api</description>

    <properties>
        <java.version>21</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 日志查询中心的数据源（ES）。用官方客户端而不是手写 RestClient：
             后续做日志统计/聚合、保存查询、bulk 写入时可以直接复用同一套客户端与连接池。
             ⚠️ 地址/凭证走 spring.elasticsearch.*（由 PLATFORM_ES_* 环境变量注入），
             功能开关仍是 platform.logs.es.url（留空 = 页面提示未配置）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>


        <!--Pod exec 中继：对前端暴露 WS，向 k8s-server 建客户端 WS（不引 fabric8）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- 告警邮件通知（S2.2.4）。只用 JavaMailSenderImpl，**不读全局 spring.mail.***
             —— 每个通知方式自带 SMTP 配置，见 EmailSender。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.xingfudeshi</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>${knife4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- S0.1 审计日志：@Auditable + AuditAspect 需要 Spring AOP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- 业务/DB 模块；K8s 侧动作全部经 k8s-server HTTP（/admin/**），本服务不依赖 k8s-core/fabric8 -->
        <dependency>
            <groupId>com.coding</groupId>
            <artifactId>platform-common</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>com.coding</groupId>
            <artifactId>platform-data</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
