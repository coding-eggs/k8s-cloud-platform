<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.coding</groupId>
    <artifactId>k8s-cloud-platform</artifactId>
    <version>1.0.0</version>
    <name>K8s Cloud Platform Parent</name>
    <description>Parent for multi-module K8s management platform</description>
    <packaging>pom</packaging>

    <properties>
        <parent.project.version>1.0.0</parent.project.version>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <spring.boot.version>4.1.2</spring.boot.version>
        <knife4j.version>4.6.0</knife4j.version>
        <mybatis.version>4.0.1</mybatis.version>
        <pageHelper.version>4.1.0</pageHelper.version>
        <fabric8.kubernetes-client.version>7.9.0</fabric8.kubernetes-client.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <nimbus.version>10.4</nimbus.version>
        <spring-cloud.version>2025.1.1</spring-cloud.version>
        <crypto.tink.version>1.21.0</crypto.tink.version>
        <swagger.version>2.2.25</swagger.version>
    </properties>

    <modules>
        <module>k8s-server</module>
        <module>platform-common</module>
        <module>k8s-core</module>
        <module>platform-data</module>
        <module>platform-auth</module>
        <module>platform-api</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 依赖管理（推荐方式） -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- AOP 启动器：Spring Boot 4 把它从 spring-boot-starter-aop 改名成
                 spring-boot-starter-aspectj（Boot 3.5 起的名字已不在 4.x 的 BOM 里）。
                 版本由上面导入的 spring-boot-dependencies BOM 管理，这里不再单列 —— 曾经钉过
                 一个 3.5.13 的老坐标，能跑只是因为 spring-aop/aspectjweaver 的版本被 BOM 兜住了，
                 等于把 Boot 3 的启动器 POM 引进 Boot 4 应用。 -->

        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>${swagger.version}</version>
        </dependency>

        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- 父项目统一管理插件版本和公共配置 -->
        <pluginManagement>
            <plugins>
                <!-- 1. Maven 编译插件（所有模块继承） -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                        <encoding>UTF-8</encoding>
                        <!-- 参数名编入字节码：Spring @RequestParam 等按名绑定依赖此项（Spring 7 无字节码兜底发现） -->
                        <parameters>true</parameters>
                        <!-- Lombok 注解处理器（保留你原来的配置） -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!-- 2. Spring Boot 插件（只声明版本和公共配置） -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>   <!-- ← 请改成你项目实际的 Spring Boot 版本 -->
                    <configuration>
                        <!-- Lombok 不打包进 fat jar（保留你原来的配置） -->
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                    <!-- ⚠️ 本父 POM 用的是 spring-boot-dependencies（BOM import），**不是**
                         spring-boot-starter-parent —— 后者才会把 repackage 绑到 package 阶段。
                         不在这里显式绑 execution 的话，`mvn package` 只跑 maven-jar-plugin，
                         产物是普通瘦 jar（MANIFEST 里没有 Main-Class、没有 BOOT-INF/），
                         镜像里 `java -jar /app/app.jar` 会直接报
                         "no main manifest attribute, in /app/app.jar"。
                         放在 pluginManagement 里 = 三个服务模块（声明了该插件的）统一生效；
                         库模块（platform-common / platform-data / k8s-core）没声明，不受影响。 -->
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
