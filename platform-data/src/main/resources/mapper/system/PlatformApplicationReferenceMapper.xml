<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coding.data.mapper.system.PlatformApplicationReferenceMapper">

  <resultMap id="BaseResultMap" type="com.coding.data.models.system.PlatformApplicationReference">
    <id     column="id"         jdbcType="BIGINT"    property="id" />
    <result column="app_id"     jdbcType="VARCHAR"   property="appId" />
    <result column="node_id"    jdbcType="VARCHAR"   property="nodeId" />
    <result column="ref_type"   jdbcType="VARCHAR"   property="refType" />
    <result column="ref_id"     jdbcType="VARCHAR"   property="refId" />
    <result column="created_at" jdbcType="TIMESTAMP" property="createdAt" />
  </resultMap>

  <sql id="Base_Column_List">
    id, app_id, node_id, ref_type, ref_id, created_at
  </sql>

  <insert id="insert" parameterType="com.coding.data.models.system.PlatformApplicationReference">
    insert into platform_application_reference (app_id, node_id, ref_type, ref_id, created_at)
    values (#{appId,jdbcType=VARCHAR}, #{nodeId,jdbcType=VARCHAR}, #{refType,jdbcType=VARCHAR},
            #{refId,jdbcType=VARCHAR}, #{createdAt,jdbcType=TIMESTAMP})
  </insert>

  <delete id="deleteByApp">
    delete from platform_application_reference where app_id = #{appId,jdbcType=VARCHAR}
  </delete>

  <select id="selectByApp" resultMap="BaseResultMap">
    select <include refid="Base_Column_List" />
    from platform_application_reference
    where app_id = #{appId,jdbcType=VARCHAR}
  </select>

  <select id="selectByRef" resultMap="BaseResultMap">
    select <include refid="Base_Column_List" />
    from platform_application_reference
    where ref_type = #{refType,jdbcType=VARCHAR}
      and ref_id = #{refId,jdbcType=VARCHAR}
  </select>

</mapper>
