<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.coding</groupId>
        <artifactId>k8s-cloud-platform</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>k8s-server</artifactId>
    <name>k8s-server</name>
    <description>k8s-server</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>com.coding</groupId>
            <artifactId>k8s-core</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.xingfudeshi</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>${knife4j.version}</version>
        </dependency>


        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- 应用商店：渲染清单的 YAML 解析（Jackson 3，版本由 Spring Boot BOM 管理） -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- 对象存储（SeaweedFS）：S3 控制面操作（建/删桶、列对象、下载）。
             MinIO SDK 专为 S3 兼容存储写，签名/分页/错误码不用自己造；
             ⚠️ 它带 Jackson 2（com.fasterxml）—— 本模块经 fabric8 的 yaml 解析已经同时存在
             Jackson 2 与 Jackson 3，两者包名不同、互不覆盖。 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.17</version>
        </dependency>

        <!--Pod exec 终端：WebSocket 握手走既有 JWT 安全链（token 可走 query）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- 2026-10-08 引入：本模块原先零测试。BoundaryAuthorizationManager 现为 k8s-server 侧唯一的
             授权判定点（AccessBoundary 三态 + fail-closed），必须有单元测试钉住决策表。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- 只在这里真正激活 Spring Boot 打包插件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- version 不用写，会自动从父项目的 pluginManagement 继承 -->
            </plugin>
        </plugins>
    </build>

</project>
